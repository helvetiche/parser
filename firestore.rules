rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // All data access flows through the server's API routes using the
    // Firebase Admin SDK, which bypasses these rules by design.
    // The browser client SDK is used for authentication only, so every
    // direct client read/write is denied. Locked down by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
